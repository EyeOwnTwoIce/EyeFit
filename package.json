{
  "name": "eyefit",
  "version": "1.0.0",
  "description": "EyeFit — App de entrenamiento privada y offline (iPhone 15)",
  "main": "dist/index.html",
  "scripts": {
    "generate": "node tools/generate_rutina.js",
    "build": "node tools/build.js",
    "gen:slim-data": "node tools/generate_slim_dataset.js",
    "gen:vapid": "node tools/generate_vapid.js",
    "push:notify": "node tools/push_notify.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "lighthouse": "npm run build && npx http-server dist -p 4173 -c-1 & lhci autorun"
  },
  "dependencies": {},
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "http-server": "^14.1.1",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "tmp": "0.2.7",
    "cookie": "0.7.0",
    "uuid": "11.1.1",
    "lighthouse": "13.4.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true
  }
}
