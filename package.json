{
  "name": "eyefit",
  "version": "2.2.7",
  "description": "EyeFit — App de entrenamiento privada y offline (iPhone 15)",
  "main": "dist/index.html",
  "scripts": {
    "generate": "node tools/generate_rutina.js",
    "build": "node tools/build.js",
    "gen:slim-data": "node tools/generate_slim_dataset.js",
    "gen:vapid": "node tools/generate_vapid.js",
    "push:notify": "node tools/push_notify.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "test:e2e": "npm run build && playwright test",
    "lighthouse": "npm run build && npx http-server dist -p 4173 -c-1 & lhci autorun"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "http-server": "^14.1.1",
    "web-push": "^4.0.0"
  },
  "overrides": {
    "tmp": "0.2.7",
    "cookie": "0.7.0",
    "uuid": "11.1.1",
    "lighthouse": "13.4.1",
    "brace-expansion": "1.1.21",
    "compression": "1.8.2",
    "ip-address": "10.7.1",
    "js-yaml": "3.15.2",
    "proxy-addr": "2.0.8",
    "@eslint/config-array": {
      "minimatch": "11.0.1"
    },
    "eslint": {
      "minimatch": "11.0.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true
  }
}
